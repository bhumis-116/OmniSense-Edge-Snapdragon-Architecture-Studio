rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmapped operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation Helper: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'targetDevice', 'preferredNpuMode', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('targetDevice' in data) || (data.targetDevice is string && data.targetDevice.size() <= 64)) &&
             (!('preferredNpuMode' in data) || (data.preferredNpuMode in ['high_performance', 'balanced', 'power_saver']));
    }

    // Validation Helper: TelemetrySession
    function isValidTelemetrySession(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'synthesizedText', 'createdAt']) &&
             data.keys().hasOnly(['id', 'userId', 'title', 'synthesizedText', 'npuLatencyMs', 'topsUtilized', 'powerWatts', 'thermalCelsius', 'activeProvider', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 160 &&
             data.synthesizedText is string && data.synthesizedText.size() <= 4096 &&
             (!('npuLatencyMs' in data) || data.npuLatencyMs is number) &&
             (!('topsUtilized' in data) || data.topsUtilized is number) &&
             (!('powerWatts' in data) || data.powerWatts is number) &&
             (!('thermalCelsius' in data) || data.thermalCelsius is number) &&
             (!('activeProvider' in data) || (data.activeProvider is string && data.activeProvider.size() <= 128));
    }

    // Users Collection & Preferences
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Saved Telemetry & Action Sessions Subcollection
      match /sessions/{sessionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) &&
                         isValidTelemetrySession(incoming()) &&
                         incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) &&
                         isValidTelemetrySession(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
